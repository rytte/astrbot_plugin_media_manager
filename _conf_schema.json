{
  "general": {
    "type": "object",
    "description": "基础设置",
    "items": {
      "platform_ids": {
        "type": "list",
        "description": "适用平台实例 ID（空为全部）",
        "default": []
      }
    }
  },
  "lightening": {
    "type": "object",
    "description": "对话图片轻量化与归档",
    "hint": "管理私聊和未进入群缓存的群聊图片，以及其他工具返回图片的归档与历史轻量化。群聊图片缓存独立控制。",
    "items": {
      "image_lighten_enabled": {
        "type": "bool",
        "description": "对话图片轻量化",
        "hint": "关闭后，未进入群缓存的图片按 AstrBot 原有方式保留，不再归档、生成引用或精简图片载荷，也不提供长期归档图片回看。群缓存的收图、引用和回看不受影响。",
        "default": true
      },
      "max_storage_mb": {
        "type": "int",
        "description": "长期归档容量（MiB）",
        "default": 2048
      },
      "retention_days": {
        "type": "int",
        "description": "原图绝对保留自然日数（0 为关闭）",
        "default": 30
      },
      "orphan_grace_days": {
        "type": "int",
        "description": "孤儿图片宽限自然日数",
        "default": 3
      }
    }
  },
  "group_cache": {
    "type": "object",
    "description": "群聊图片缓存",
    "hint": "配合 AstrBot 群聊上下文注入，支持先发图、后唤醒时按引用查看图片。",
    "items": {
      "group_cache_enabled": {
        "type": "bool",
        "description": "缓存群聊上下文图片",
        "default": true
      },
      "group_cache_max_mb": {
        "type": "int",
        "description": "群图片缓存容量（MiB）",
        "default": 256
      },
      "group_cache_ttl_hours": {
        "type": "int",
        "description": "群图片有效期（小时）",
        "default": 24
      }
    }
  },
  "inspection": {
    "type": "object",
    "description": "图片查看与清理",
    "items": {
      "max_inspect_mb": {
        "type": "int",
        "description": "单次图片查看上限（MiB）",
        "default": 10
      },
      "disabled_views": {
        "type": "list",
        "description": "禁用的查看方式",
        "default": [],
        "options": ["original", "animation"]
      },
      "cleanup_interval_seconds": {
        "type": "int",
        "description": "清理检测间隔（秒）",
        "default": 600
      }
    }
  }
}
