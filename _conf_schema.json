{
  "enabled": {
    "type": "bool",
    "description": "启用媒体图片管理",
    "default": true
  },
  "group_cache_enabled": {
    "type": "bool",
    "description": "缓存群聊上下文图片",
    "default": true
  },
  "group_cache_max_mb": {
    "type": "int",
    "description": "群图片缓存容量（MiB）",
    "default": 256
  },
  "group_cache_ttl_hours": {
    "type": "int",
    "description": "群图片有效期（小时）",
    "default": 24
  },
  "orphan_grace_days": {
    "type": "int",
    "description": "孤儿图片宽限自然日数",
    "default": 3
  },
  "retention_days": {
    "type": "int",
    "description": "原图绝对保留自然日数（0 为关闭）",
    "default": 30
  },
  "max_storage_mb": {
    "type": "int",
    "description": "长期归档容量（MiB）",
    "default": 2048
  },
  "max_inspect_mb": {
    "type": "int",
    "description": "单次图片查看上限（MiB）",
    "default": 10
  },
  "max_components": {
    "type": "int",
    "description": "每条消息最多缓存图片数",
    "hint": "按消息顺序（含引用图片）最多尝试缓存这些图片，失败也占一个名额。所有图片都会分配关联标识；实际进入模型请求的图片仍会归档和轻量化。",
    "default": 30,
    "minimum": 1,
    "maximum": 100
  },
  "cleanup_interval_seconds": {
    "type": "int",
    "description": "清理检测间隔（秒）",
    "default": 600
  },
  "disabled_views": {
    "type": "list",
    "description": "禁用的查看方式",
    "default": [],
    "options": ["original", "animation"]
  },
  "platform_ids": {
    "type": "list",
    "description": "适用平台实例 ID（空为全部）",
    "default": []
  },
  "import_qq_enhance": {
    "type": "bool",
    "description": "首次导入旧 QQ 图片配置和数据",
    "default": true
  }
}
